[mysqld]
datadir = /data/mysql
socket = /run/mysqld/mysqld.sock
# The database is only reachable from inside the container, via the socket
skip-networking
skip-name-resolve
# Must be at least as large as the largest accepted upload
max_allowed_packet = 128M
character-set-server = utf8mb4

[client]
socket = /run/mysqld/mysqld.sock
